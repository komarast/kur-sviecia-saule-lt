# Copy to server/.env and adjust. All values are optional.

# Port and bind address for the server (serves both API and built client)
PORT=3001
HOST=0.0.0.0

# Comma-separated list of origins allowed to call /api cross-origin.
# Leave empty when the client is served by this same server (recommended).
CORS_ORIGIN=

# Secret for POST /api/refresh (send as header "x-refresh-token").
# If empty the endpoint is disabled (404).
REFRESH_TOKEN=

# Number of reverse proxies in front of the app (e.g. 1 behind nginx/Render/Fly).
# Needed for correct per-client rate limiting.
TRUST_PROXY=

# Requests per minute per IP for /api (default 120)
RATE_LIMIT_PER_MINUTE=

# Override the built client location (default: ../client/dist)
CLIENT_DIST=
